# Postgres connection (matches docker-compose.yml)
DATABASE_URL=postgres://sotamhsk:sotamhsk_dev_password@localhost:5432/sotamhsk

# JWT signing secrets — generate strong random values for production
# e.g. `openssl rand -hex 32`
JWT_SECRET=replace-me-with-32-byte-hex-secret
JWT_REFRESH_SECRET=replace-me-with-another-32-byte-hex-secret

# Google OAuth (Phase 1 — fill in once you create the OAuth client)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list. If unset, a sensible default list is used.
# ALLOWED_ORIGINS=https://hanngusotam.com,https://www.hanngusotam.com

# Published Google Sheet CSV URL for the class schedule on the landing page.
# Get it from: Google Sheet → File → Share → Publish to web → CSV → Publish → copy URL.
# When unset, the /schedule endpoint returns an empty list and the frontend
# falls back to its hardcoded sample rows.
# SCHEDULE_CSV_URL=https://docs.google.com/spreadsheets/d/e/<long-id>/pub?gid=0&single=true&output=csv

# Legacy Firebase admin (kept until Phase 1 fully migrates auth)
# FB_SERVICE_ACCOUNT_JSON=
