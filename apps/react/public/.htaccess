# SPA fallback + www canonical redirect
# Works on both Apache and LiteSpeed (LiteSpeed reads .htaccess natively).

Options -MultiViews
RewriteEngine On

# 1. Force www — redirect non-www to www (HTTP and HTTPS)
RewriteCond %{HTTP_HOST} ^hanngusotam\.com$ [NC]
RewriteRule ^ https://www.hanngusotam.com%{REQUEST_URI} [R=301,L]

# 2. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 3. SPA fallback — serve index.html for any path that isn't a real file/dir
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]
