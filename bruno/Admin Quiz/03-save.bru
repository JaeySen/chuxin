meta {
  name: Save Parsed Quiz
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/admin/quiz/save
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{jwt}}
}

body:json {
  {
    "title": "Bài 1 HSK1",
    "slug": "bai-1-hsk1",
    "source": "Bài-1-HSK1.pdf",
    "questions": [
      {
        "num": 1,
        "text": "这是什么？",
        "type": "mcq",
        "options": { "A": "书", "B": "笔", "C": "纸", "D": "桌" },
        "answer": "A"
      }
    ]
  }
}

docs {
  Saves parsed quiz JSON to content/quizzes/<slug>.json.
  Requires admin role.
}
