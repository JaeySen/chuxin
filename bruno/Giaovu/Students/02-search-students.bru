meta {
  name: Search Students
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/giaovu/students/search
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{jwt}}
}

params:query {
  q: nguyễn
}

docs {
  Searches display_name, email, phone (ILIKE). Min 2 chars. Returns up to 10 results.
  Used by enrollment UI autocomplete.
}
