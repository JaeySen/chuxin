meta {
  name: Patch Settings
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/admin/settings
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{jwt}}
}

body:json {
  {
    "allow_signup": true,
    "disable_email_login": false,
    "allow_phone_login": true,
    "guest_games_enabled": true
  }
}
